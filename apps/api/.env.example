# Copie a apps/api/.env para desarrollo local. NUNCA suba el .env al repositorio (es público).
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://cmms:cmms@localhost:5432/cmms?schema=public
# Genere uno propio: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14
CORS_ORIGIN=http://localhost:3000
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Solo para el primer seed (usuario administrador inicial; se fuerza el cambio al ingresar)
SEED_ADMIN_EMAIL=admin@olast.local
SEED_ADMIN_PASSWORD=
# Integración Ituran (doc 07 §9) — se completa en el entorno, no aquí
ITURAN_USER=
ITURAN_PASSWORD=
ITURAN_COMPANY=

# Notificaciones por correo (Sprint 4). Sin SMTP_HOST se registran solo en la app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CMMS OLAST <no-responder@olast.co>"
APP_URL=http://localhost:3000
