// CMMS-OLAST · Esquema Sprint 0 (doc 04). Convención: modelos PascalCase, tablas snake_case plural.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Organización y seguridad ─────────────

model Organization {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  taxId        String?  @map("tax_id")
  countryCode  String   @default("CO") @map("country_code") @db.Char(2)
  currency     String   @default("COP") @db.Char(3)
  distanceUnit String   @default("km") @map("distance_unit")
  volumeUnit   String   @default("gal") @map("volume_unit")
  timezone     String   @default("America/Bogota")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sites    Site[]
  users    User[]
  roles    Role[]
  vehicles Vehicle[]
  drivers  Driver[]

  @@map("organizations")
}

model Site {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  city           String?
  address        String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id])
  userSites    UserSite[]
  vehicles     Vehicle[]
  drivers      Driver[]
  siteHistory  VehicleSiteLog[]

  @@unique([organizationId, code])
  @@map("sites")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  /// Rol global: ve todas las sedes. Si es false, el usuario ve solo sus sedes asignadas.
  isGlobal       Boolean  @default(false) @map("is_global")
  permissions    String[]
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]

  @@unique([organizationId, code])
  @@map("roles")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  roleId             String    @map("role_id") @db.Uuid
  email              String
  fullName           String    @map("full_name")
  phone              String?
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  active             Boolean   @default(true)
  failedLogins       Int       @default(0) @map("failed_logins")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  organization  Organization   @relation(fields: [organizationId], references: [id])
  role          Role           @relation(fields: [roleId], references: [id])
  sites         UserSite[]
  refreshTokens RefreshToken[]

  @@unique([organizationId, email])
  @@map("users")
}

model UserSite {
  userId String @map("user_id") @db.Uuid
  siteId String @map("site_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([userId, siteId])
  @@map("user_sites")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  entity         String
  entityId       String?  @map("entity_id")
  action         String
  diff           Json?
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// ───────────── Catálogos (doc 03 y doc 09) ─────────────

model ComponentCode {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique
  name         String
  level        Int
  parentId     String? @map("parent_id") @db.Uuid
  vmrsCode     String? @map("vmrs_code")
  /// Patrón de texto para clasificar historial (migración).
  matchPattern String? @map("match_pattern")
  active       Boolean @default(true)

  parent   ComponentCode?  @relation("ComponentTree", fields: [parentId], references: [id])
  children ComponentCode[] @relation("ComponentTree")

  @@index([parentId])
  @@map("component_codes")
}

model FailureMode {
  code   String  @id
  name   String
  active Boolean @default(true)

  @@map("failure_modes")
}

model FailureCause {
  code   String  @id
  name   String
  active Boolean @default(true)

  @@map("failure_causes")
}

model RepairAction {
  code   String  @id
  name   String
  active Boolean @default(true)

  @@map("repair_actions")
}

model HoldReason {
  code   String  @id
  name   String
  active Boolean @default(true)

  @@map("hold_reasons")
}

model WorkOrderTypeDef {
  code                  String  @id
  name                  String
  isPlanned             Boolean @map("is_planned")
  requiresFailureCoding Boolean @map("requires_failure_coding")
  description           String?

  @@map("work_order_types")
}

model PriorityDef {
  code                  String @id
  name                  String
  targetResponseHours   Int    @map("target_response_hours")
  targetResolutionHours Int    @map("target_resolution_hours")

  @@map("priorities")
}

model VehicleType {
  id            String  @id @default(uuid()) @db.Uuid
  code          String  @unique
  name          String
  primaryMeter  String  @default("odometer") @map("primary_meter")
  maxDailyUsage Int     @map("max_daily_usage")
  active        Boolean @default(true)

  checklistTemplates ChecklistTemplate[]
  models             VehicleModel[]

  @@map("vehicle_types")
}

model DocumentType {
  id         String  @id @default(uuid()) @db.Uuid
  code       String  @unique
  name       String
  isBlocking Boolean @default(false) @map("is_blocking")
  alertDays  Int[]   @default([30, 15, 7]) @map("alert_days")
  active     Boolean @default(true)

  documents VehicleDocument[]

  @@map("document_types")
}

model ChecklistTemplate {
  id            String  @id @default(uuid()) @db.Uuid
  vehicleTypeId String  @map("vehicle_type_id") @db.Uuid
  name          String
  kind          String  @default("pre_trip")
  version       Int     @default(1)
  active        Boolean @default(true)

  vehicleType VehicleType     @relation(fields: [vehicleTypeId], references: [id])
  items       ChecklistItem[]

  @@unique([vehicleTypeId, kind, version])
  @@map("checklist_templates")
}

model ChecklistItem {
  id                  String  @id @default(uuid()) @db.Uuid
  checklistTemplateId String  @map("checklist_template_id") @db.Uuid
  sequence            Int
  text                String
  componentCode       String? @map("component_code")
  isCritical          Boolean @default(false) @map("is_critical")
  requiresPhotoOnFail Boolean @default(false) @map("requires_photo_on_fail")

  template ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)

  @@map("checklist_items")
}

// ───────────── Activos: vehículos, lecturas y documentos (Sprint 1 · doc 02 P1, P2, P8, P9) ─────────────

enum VehicleStatus {
  operational
  operational_restricted
  out_of_service_maintenance
  out_of_service_parts
  out_of_service_accident
  out_of_service_administrative
  reserve
  retired
}

enum Ownership {
  own
  leasing
  rental
  third_party
}

enum MeterType {
  odometer
  hourmeter
}

enum MeterSource {
  inspection
  work_order
  fuel
  gps
  manual
  import
}

model VehicleModel {
  id            String  @id @default(uuid()) @db.Uuid
  vehicleTypeId String  @map("vehicle_type_id") @db.Uuid
  make          String
  model         String
  fuelType      String? @map("fuel_type")
  /// Datos técnicos variables (cilindrada, potencia, ejes…).
  attributes    Json    @default("{}")

  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id])
  vehicles    Vehicle[]

  @@unique([make, model])
  @@map("vehicle_models")
}

model Driver {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  siteId          String?   @map("site_id") @db.Uuid
  userId          String?   @unique @map("user_id") @db.Uuid
  fullName        String    @map("full_name")
  documentId      String?   @map("document_id")
  phone           String?
  licenseNumber   String?   @map("license_number")
  licenseCategory String?   @map("license_category")
  licenseExpiry   DateTime? @map("license_expiry") @db.Date
  email           String?
  notes           String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id])
  site         Site?           @relation(fields: [siteId], references: [id])
  vehicles     VehicleDriver[]

  @@unique([organizationId, documentId])
  @@map("drivers")
}

model Vehicle {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  siteId           String        @map("site_id") @db.Uuid
  vehicleModelId   String        @map("vehicle_model_id") @db.Uuid
  plate            String
  internalCode     String?       @map("internal_code")
  vin              String?
  engineNumber     String?       @map("engine_number")
  year             Int?
  color            String?
  serviceType      String?       @map("service_type") /// público / particular
  registrationCity String?       @map("registration_city")
  ownership        Ownership     @default(own)
  /// Titular de la licencia de tránsito (empresa, banco del leasing, tercero).
  titleHolder      String?       @map("title_holder")
  loadCapacityKg   Int?          @map("load_capacity_kg")
  criticality      String?       @db.Char(1)
  criticalityScore Json?         @map("criticality_score")
  status           VehicleStatus @default(operational)
  statusReason     String?       @map("status_reason")
  currentOdometer  Int?          @map("current_odometer")
  currentHourmeter Int?          @map("current_hourmeter")
  /// Compensación acumulada por cambios de odómetro (km reales = lectura + offset).
  odometerOffset   Int           @default(0) @map("odometer_offset")
  lastReadingAt    DateTime?     @map("last_reading_at") @db.Timestamptz
  acquisitionDate  DateTime?     @map("acquisition_date") @db.Date
  acquisitionCost  Decimal?      @map("acquisition_cost") @db.Decimal(14, 2)
  inServiceDate    DateTime?     @map("in_service_date") @db.Date
  costCenter       String?       @map("cost_center")
  notes            String?
  /// Datos variables: llantas (medida, cantidad por eje, marca, índice de carga), etc.
  attributes       Json          @default("{}")
  retiredAt        DateTime?     @map("retired_at") @db.Date
  retirementReason String?       @map("retirement_reason")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization       @relation(fields: [organizationId], references: [id])
  site         Site               @relation(fields: [siteId], references: [id])
  vehicleModel VehicleModel       @relation(fields: [vehicleModelId], references: [id])
  statusLog    VehicleStatusLog[]
  readings     MeterReading[]
  replacements MeterReplacement[]
  documents    VehicleDocument[]
  drivers      VehicleDriver[]
  siteHistory  VehicleSiteLog[]
  tireChanges  TireChange[]
  workRequests WorkRequest[]
  workOrders   WorkOrder[]

  @@unique([organizationId, plate])
  @@index([siteId, status])
  @@map("vehicles")
}

model VehicleStatusLog {
  id          String        @id @default(uuid()) @db.Uuid
  vehicleId   String        @map("vehicle_id") @db.Uuid
  status      VehicleStatus
  reason      String?
  startedAt   DateTime      @map("started_at") @db.Timestamptz
  endedAt     DateTime?     @map("ended_at") @db.Timestamptz
  workOrderId String?       @map("work_order_id") @db.Uuid
  userId      String?       @map("user_id") @db.Uuid
  source      String        @default("manual") /// manual | auto | import

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startedAt])
  @@map("vehicle_status_log")
}

model MeterReading {
  id               String      @id @default(uuid()) @db.Uuid
  vehicleId        String      @map("vehicle_id") @db.Uuid
  meterType        MeterType   @default(odometer) @map("meter_type")
  value            Int
  /// Valor real acumulado (value + offset vigente).
  accumulatedValue Int         @map("accumulated_value")
  readAt           DateTime    @map("read_at") @db.Timestamptz
  source           MeterSource @default(manual)
  isFlagged        Boolean     @default(false) @map("is_flagged")
  flagReason       String?     @map("flag_reason")
  userId           String?     @map("user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, meterType, readAt])
  @@map("meter_readings")
}

model MeterReplacement {
  id              String    @id @default(uuid()) @db.Uuid
  vehicleId       String    @map("vehicle_id") @db.Uuid
  meterType       MeterType @default(odometer) @map("meter_type")
  oldFinalValue   Int       @map("old_final_value")
  newInitialValue Int       @map("new_initial_value")
  replacedAt      DateTime  @map("replaced_at") @db.Timestamptz
  reason          String
  userId          String?   @map("user_id") @db.Uuid

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("meter_replacements")
}

model VehicleDocument {
  id             String    @id @default(uuid()) @db.Uuid
  vehicleId      String    @map("vehicle_id") @db.Uuid
  documentTypeId String    @map("document_type_id") @db.Uuid
  number         String?
  issuer         String?
  issuedAt       DateTime? @map("issued_at") @db.Date
  expiresAt      DateTime? @map("expires_at") @db.Date
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id])

  @@unique([vehicleId, documentTypeId])
  @@map("vehicle_documents")
}

/// Conductores habilitados por vehículo (uno o varios; cualquiera puede hacer la inspección diaria).
model VehicleDriver {
  vehicleId  String   @map("vehicle_id") @db.Uuid
  driverId   String   @map("driver_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@id([vehicleId, driverId])
  @@index([driverId])
  @@map("vehicle_drivers")
}

/// Historial de sedes: los vehículos se reubican según la operación (costos y KPI por sede usan este historial).
model VehicleSiteLog {
  id        String    @id @default(uuid()) @db.Uuid
  vehicleId String    @map("vehicle_id") @db.Uuid
  siteId    String    @map("site_id") @db.Uuid
  startedAt DateTime  @map("started_at") @db.Timestamptz
  endedAt   DateTime? @map("ended_at") @db.Timestamptz
  reason    String?
  userId    String?   @map("user_id") @db.Uuid

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id])

  @@index([vehicleId, startedAt])
  @@map("vehicle_site_log")
}

enum TireAxle {
  front
  rear
  spare
}

enum TireChangeReason {
  wear /// desgaste
  road_damage /// daño en la vía (pinchazo, estallido, corte)
  theft /// robo (típicamente la de repuesto)
  rotation /// rotación entre posiciones
  other
  unknown /// histórico sin motivo
}

/// Registro de cambio de llantas (fase 1). El seguimiento por número de serie es fase 2.
model TireChange {
  id          String           @id @default(uuid()) @db.Uuid
  vehicleId   String           @map("vehicle_id") @db.Uuid
  changedAt   DateTime         @map("changed_at") @db.Timestamptz
  odometer    Int?
  axle        TireAxle
  quantity    Int
  /// Posiciones específicas opcionales (p. ej. DEL-IZQ, TRAS-DER-EXT).
  positions   String[]
  reason      TireChangeReason
  tireSize    String?          @map("tire_size")
  tireBrand   String?          @map("tire_brand")
  unitCost    Decimal?         @map("unit_cost") @db.Decimal(14, 2)
  totalCost   Decimal?         @map("total_cost") @db.Decimal(14, 2)
  supplier    String?
  notes       String?
  workOrderId String?          @map("work_order_id") @db.Uuid
  userId      String?          @map("user_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([vehicleId, changedAt])
  @@map("tire_changes")
}

// ───────────── Avisos y órdenes de trabajo (Sprint 2 · doc 02 P4, P7) ─────────────

/// Numeración correlativa sin huecos por organización, serie y año (AV-2026-000001, OT-2026-000001).
model Counter {
  organizationId String @map("organization_id") @db.Uuid
  series         String
  year           Int
  value          Int    @default(0)

  @@id([organizationId, series, year])
  @@map("counters")
}

model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  taxId          String?  @map("tax_id")
  kind           String   @default("workshop") /// workshop | parts | dealer | tires | other
  city           String?
  contact        String?
  phone          String?
  email          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  workOrders       WorkOrder[]
  externalServices WorkOrderExternalService[]

  @@unique([organizationId, name])
  @@map("suppliers")
}

model Technician {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @unique @map("user_id") @db.Uuid
  siteId         String?  @map("site_id") @db.Uuid
  name           String
  level          String   @default("N2")
  hourlyCost     Decimal  @default(0) @map("hourly_cost") @db.Decimal(14, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  labor WorkOrderLabor[]

  @@map("technicians")
}

model Part {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  description    String
  unit           String   @default("UND")
  referenceCost  Decimal? @map("reference_cost") @db.Decimal(14, 2)
  componentCode  String?  @map("component_code")
  active         Boolean  @default(true)

  @@unique([organizationId, code])
  @@map("parts")
}

enum WorkRequestStatus {
  new
  in_review
  approved
  rejected
  merged
}

enum CanOperate {
  yes
  restricted
  no
}

model WorkRequest {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  number          String
  vehicleId       String            @map("vehicle_id") @db.Uuid
  source          String            @default("driver") /// driver | inspection | technician | roadside | accident
  description     String
  systemCode      String?           @map("system_code")
  canOperate      CanOperate        @default(yes) @map("can_operate")
  consequence     String? /// safety_legal | stops_operation | degraded | no_impact
  priority        String?
  status          WorkRequestStatus @default(new)
  rejectionReason String?           @map("rejection_reason")
  odometer        Int?
  workOrderId     String?           @map("work_order_id") @db.Uuid
  reportedById    String?           @map("reported_by_id") @db.Uuid
  reportedAt      DateTime          @default(now()) @map("reported_at") @db.Timestamptz
  reviewedById    String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?         @map("reviewed_at") @db.Timestamptz

  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id])
  workOrder WorkOrder?   @relation(fields: [workOrderId], references: [id])
  photos    Attachment[]

  @@unique([organizationId, number])
  @@index([status, reportedAt])
  @@map("work_requests")
}

enum WorkOrderStatus {
  planned
  scheduled
  in_progress
  on_hold
  completed
  closed
  cancelled
}

model WorkOrder {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  number          String
  vehicleId       String          @map("vehicle_id") @db.Uuid
  siteId          String          @map("site_id") @db.Uuid
  type            String /// PM | INS | PDM | CP | CE | AUX | SIN | MEJ | CAM
  priority        String          @default("P3")
  status          WorkOrderStatus @default(planned)
  origin          String          @default("manual") /// request | pm | campaign | manual | import
  description     String
  workshopType    String          @default("external") @map("workshop_type") /// internal | external
  supplierId      String?         @map("supplier_id") @db.Uuid
  odometerIn      Int?            @map("odometer_in")
  odometerOut     Int?            @map("odometer_out")
  plannedStart    DateTime?       @map("planned_start") @db.Timestamptz
  plannedEnd      DateTime?       @map("planned_end") @db.Timestamptz
  estimatedHours  Decimal?        @map("estimated_hours") @db.Decimal(8, 2)
  actualStart     DateTime?       @map("actual_start") @db.Timestamptz
  actualEnd       DateTime?       @map("actual_end") @db.Timestamptz
  closedAt        DateTime?       @map("closed_at") @db.Timestamptz
  closedById      String?         @map("closed_by_id") @db.Uuid
  createdById     String?         @map("created_by_id") @db.Uuid
  isRework        Boolean         @default(false) @map("is_rework")
  reworkOfId      String?         @map("rework_of_id") @db.Uuid
  laborCost       Decimal         @default(0) @map("labor_cost") @db.Decimal(14, 2)
  partsCost       Decimal         @default(0) @map("parts_cost") @db.Decimal(14, 2)
  externalCost    Decimal         @default(0) @map("external_cost") @db.Decimal(14, 2)
  totalCost       Decimal         @default(0) @map("total_cost") @db.Decimal(14, 2)
  cancelReason    String?         @map("cancel_reason")
  completionNotes String?         @map("completion_notes")
  /// Fecha aproximada o datos parciales (migración del historial en Excel).
  isHistorical    Boolean         @default(false) @map("is_historical")
  /// Referencia de origen en importaciones (p. ej. "historial:gvr370:12"); evita duplicados al reimportar.
  sourceRef       String?         @unique @map("source_ref")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  vehicle          Vehicle                    @relation(fields: [vehicleId], references: [id])
  supplier         Supplier?                  @relation(fields: [supplierId], references: [id])
  reworkOf         WorkOrder?                 @relation("Rework", fields: [reworkOfId], references: [id])
  reworks          WorkOrder[]                @relation("Rework")
  requests         WorkRequest[]
  tasks            WorkOrderTask[]
  labor            WorkOrderLabor[]
  parts            WorkOrderPart[]
  externalServices WorkOrderExternalService[]
  holds            WorkOrderHold[]
  failures         FailureRecord[]
  events           WorkOrderEvent[]
  tireChanges      TireChange[]
  attachments      Attachment[]

  @@unique([organizationId, number])
  @@index([vehicleId, status])
  @@index([status, priority])
  @@map("work_orders")
}

model WorkOrderTask {
  id            String  @id @default(uuid()) @db.Uuid
  workOrderId   String  @map("work_order_id") @db.Uuid
  sequence      Int
  description   String
  status        String  @default("pending") /// pending | done | not_done | finding
  notDoneReason String? @map("not_done_reason")
  comment       String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("work_order_tasks")
}

model WorkOrderLabor {
  id           String   @id @default(uuid()) @db.Uuid
  workOrderId  String   @map("work_order_id") @db.Uuid
  technicianId String   @map("technician_id") @db.Uuid
  workDate     DateTime @map("work_date") @db.Date
  hours        Decimal  @db.Decimal(6, 2)
  hourlyCost   Decimal  @map("hourly_cost") @db.Decimal(14, 2)
  cost         Decimal  @db.Decimal(14, 2)
  comment      String?

  workOrder  WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  technician Technician @relation(fields: [technicianId], references: [id])

  @@map("work_order_labor")
}

model WorkOrderPart {
  id          String  @id @default(uuid()) @db.Uuid
  workOrderId String  @map("work_order_id") @db.Uuid
  partId      String? @map("part_id") @db.Uuid
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitCost    Decimal @map("unit_cost") @db.Decimal(14, 2)
  totalCost   Decimal @map("total_cost") @db.Decimal(14, 2)
  source      String  @default("direct_purchase") /// stock | direct_purchase

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("work_order_parts")
}

model WorkOrderExternalService {
  id            String  @id @default(uuid()) @db.Uuid
  workOrderId   String  @map("work_order_id") @db.Uuid
  supplierId    String? @map("supplier_id") @db.Uuid
  description   String
  invoiceNumber String? @map("invoice_number")
  amount        Decimal @db.Decimal(14, 2)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  supplier  Supplier? @relation(fields: [supplierId], references: [id])

  @@map("work_order_external_services")
}

model WorkOrderHold {
  id          String    @id @default(uuid()) @db.Uuid
  workOrderId String    @map("work_order_id") @db.Uuid
  reason      String
  comment     String?
  startedAt   DateTime  @map("started_at") @db.Timestamptz
  endedAt     DateTime? @map("ended_at") @db.Timestamptz

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("work_order_holds")
}

model FailureRecord {
  id            String  @id @default(uuid()) @db.Uuid
  workOrderId   String  @map("work_order_id") @db.Uuid
  componentCode String  @map("component_code")
  failureMode   String? @map("failure_mode")
  cause         String?
  action        String?
  comment       String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([componentCode])
  @@map("failure_records")
}

/// Bitácora de la OT: cambios de estado y acciones relevantes.
model WorkOrderEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workOrderId String   @map("work_order_id") @db.Uuid
  action      String
  fromStatus  String?  @map("from_status")
  toStatus    String?  @map("to_status")
  comment     String?
  userId      String?  @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId, createdAt])
  @@map("work_order_events")
}

model Attachment {
  id            String   @id @default(uuid()) @db.Uuid
  storageKey    String   @unique @map("storage_key")
  filename      String
  mimeType      String   @map("mime_type")
  size          Int
  workRequestId String?  @map("work_request_id") @db.Uuid
  workOrderId   String?  @map("work_order_id") @db.Uuid
  uploadedById  String?  @map("uploaded_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  workRequest WorkRequest? @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("attachments")
}
